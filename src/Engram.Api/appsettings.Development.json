{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=engram_db;Username=postgres;Password=postgres"
  },
  "AuthSettings": {
    "SecretKey": "engram_super_secret_auth_key_must_be_extremely_long_at_least_32_characters",
    "Issuer": "engram-identity-provider",
    "Audience": "engram-app-clients",
    "Expires": "00:15:00",
    "RefreshExpires": "7.00:00:00"
  }
}
